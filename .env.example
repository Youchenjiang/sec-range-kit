# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Event evidence and notes live outside the repository.
RANGE_KIT_DATA_ROOT=/path/to/event-data
# Extra allowed roots, os.pathsep-separated (optional).
RANGE_KIT_ALLOWED_ROOTS=

# rangekit.vm.vmrun_guest
VM_VMX=C:/path/to/analysis-vm.vmx
# Optional: defaults to vmrun on PATH, then the standard VMware Workstation path.
VM_VMRUN=
# Guest credentials; .env is the default --creds-file.
VM_GU=<guest user>
VM_GP=<guest password>
